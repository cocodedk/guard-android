#!/bin/sh
set -eu

# ── Part 1: owner-lock the push URL ──────────────────────────────────────────
# git invokes pre-push as: pre-push <remote-name> <remote-url>
remote_url="${2:-}"

case "$remote_url" in
  https://github.com/cocodedk/*|git@github.com:cocodedk/*|ssh://git@github.com/cocodedk/*) ;;
  *)
    echo "pre-push: refusing — push URL is not under github.com/cocodedk" >&2
    echo "  remote: ${1:-?}" >&2
    echo "  url:    $remote_url" >&2
    exit 1
    ;;
esac

# ── Part 2: block force-push and deletion of protected branches ──────────────
# git passes one line per ref on stdin: <local_ref> <local_sha> <remote_ref> <remote_sha>
ZERO='0000000000000000000000000000000000000000'

while read -r _local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main|refs/heads/master|refs/heads/production|refs/heads/release) ;;
    *) continue ;;
  esac
  branch="${remote_ref#refs/heads/}"

  if [ "$local_sha" = "$ZERO" ]; then
    echo "pre-push: blocked deletion of protected branch '$branch'" >&2
    echo "          bypass: git push --no-verify" >&2
    exit 1
  fi

  if [ "$remote_sha" != "$ZERO" ] && \
     ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
    echo "pre-push: blocked non-fast-forward push to protected branch '$branch'" >&2
    echo "          bypass: git push --no-verify" >&2
    exit 1
  fi
done

# ── Part 3: full verification gate ──────────────────────────────────────────
# Gradle needs a JDK, and this machine may not have one on PATH. Fail with the
# actual reason instead of a Gradle stacktrace that buries it.
if ! command -v java >/dev/null 2>&1 && [ -z "${JAVA_HOME:-}" ]; then
  echo "pre-push: no Java found. Set JAVA_HOME to a JDK 17 install, or install one." >&2
  exit 1
fi

echo "pre-push: running full verification (./gradlew buildSmoke)..." >&2
./gradlew buildSmoke --no-daemon
