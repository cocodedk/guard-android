#!/bin/sh
set -eu

# Fast static checks only. The full suite runs at pre-push, so the commit loop
# stays quick enough that nobody is tempted to use --no-verify. Lint only reads
# the app and the build files, so commits touching neither skip it.
if ! git diff --cached --name-only | grep -qE '^(app/|gradle|[^/]*\.gradle\.kts$)'; then
  exit 0
fi

# Gradle needs a JDK, and this machine may not have one on PATH. Fail with the
# actual reason instead of a Gradle stacktrace that buries it.
if ! command -v java >/dev/null 2>&1 && [ -z "${JAVA_HOME:-}" ]; then
  echo "pre-commit: no Java found. Set JAVA_HOME to a JDK 17 install, or install one." >&2
  exit 1
fi

echo "pre-commit: linting..." >&2
./gradlew lintDebug --quiet
